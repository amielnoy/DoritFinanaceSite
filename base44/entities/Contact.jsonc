{
  // מי פנה, ובאיזה ערוץ — רשומה אחת לאדם, לא רשומה אחת לפנייה.
  //
  // `Lead` הוא אירוע: פנייה אחת, ברגע אחד, עם מה שנמסר בה. `Contact` הוא האדם
  // שמאחורי הפניות, ומתעדכן כשמתברר עוד. הטלפון הוא המפתח מפני שבוואטסאפ הוא
  // מה שיש — ההודעה מגיעה ממנו, לפני שנאמר שם כלשהו.
  //
  // מה שאין כאן חשוב לא פחות ממה שיש: אין ת"ז, אין מספרי פוליסה או חשבון, אין
  // נתוני שכר ואין מידע רפואי. סוכן שנתקל בהם מונחה להעביר לאדם ולא לרשום, וזו
  // חובת צמצום המידע לפי חוק הגנת הפרטיות, התשמ״א-1981 ותיקון 13.
  "name": "Contact",
  "type": "object",
  "properties": {
    "phone": {
      "type": "string",
      "title": "טלפון",
      "description": "המפתח לזיהוי. בוואטסאפ זהו המספר ששלח את ההודעה."
    },
    "name": {
      "type": "string",
      "title": "שם"
    },
    "email": {
      "type": "string",
      "title": "אימייל"
    },
    "channel": {
      "type": "string",
      "title": "ערוץ ההיכרות הראשון",
      "enum": ["whatsapp", "site", "phone", "other"],
      "default": "other"
    },
    "notes": {
      "type": "string",
      "title": "הערות",
      "description": "הקשר קצר שהאדם מסר מיוזמתו. ללא פרטים מזהים או רגישים."
    },
    "last_seen": {
      "type": "string",
      "title": "פנייה אחרונה",
      "description": "חותמת זמן ISO של הפעם האחרונה שהאדם יצר קשר."
    }
  },
  "required": ["phone"],
  "rls": {
    "create": true,
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
