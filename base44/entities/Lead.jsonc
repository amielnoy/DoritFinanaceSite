{
  "name": "Lead",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "שם"
    },
    "phone": {
      "type": "string",
      "title": "טלפון"
    },
    "email": {
      "type": "string",
      "title": "אימייל"
    },
    "source": {
      "type": "string",
      "title": "מקור הפנייה",
      "enum": [
        "consultation",
        "detailed",
        "quick",
        "claim",
        "escalation"
      ]
    },
    "topic": {
      "type": "string",
      "title": "תחום / שירות"
    },
    "timing": {
      "type": "string",
      "title": "מועד"
    },
    "message": {
      "type": "string",
      "title": "הודעה"
    },
    "status": {
      "type": "string",
      "title": "סטטוס",
      "enum": [
        "new",
        "contacted",
        "closed",
        "escalated"
      ],
      "default": "new"
    },
    "escalation_reason": {
      "type": "string",
      "title": "סיבת ההעברה לטיפול אנושי",
      "description": "מדוע הסוכן האוטומטי הפסיק לטפל והעביר את הפנייה לדורית. ריק בפניות שלא הועברו.",
      "enum": [
        "regulated_advice",
        "product_recommendation",
        "numbers_or_returns",
        "claim_or_policy",
        "complaint",
        "privacy_request",
        "sensitive_data",
        "out_of_scope",
        "user_request",
        "uncertain"
      ]
    },
    "handled_by_agent": {
      "type": "string",
      "title": "סוכן אוטומטי מטפל",
      "description": "שם הסוכן שבו נפתחה השיחה, לצורך תיעוד ובקרה."
    },
    "consent_version": {
      "type": "string",
      "title": "גרסת ההסכמה שאושרה",
      "description": "מזהה נוסח ההסכמה שהוצג למבקר בעת האיסוף — חובת יידוע לפי חוק הגנת הפרטיות."
    },
    "consent_at": {
      "type": "string",
      "title": "מועד מתן ההסכמה",
      "description": "חותמת זמן ISO של אישור ההסכמה בממשק."
    }
  },
  "required": [
    "name",
    "phone"
  ],
  "rls": {
    "create": true,
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
