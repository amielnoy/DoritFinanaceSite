{
  "description": "\u05e1\u05d5\u05db\u05df \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9 \u05e9\u05de\u05de\u05dc\u05d9\u05e5 \u05e2\u05dc \u05de\u05d0\u05de\u05e8\u05d9\u05dd \u05de\u05d4\u05d1\u05dc\u05d5\u05d2 \u05e9\u05dc \u05d3\u05d5\u05e8\u05d9\u05ea \u05d2\u05d5\u05d1 \u05d0\u05e8\u05d9 \u05e2\u05dc \u05e1\u05de\u05da \u05de\u05dc\u05d5\u05d0 \u05d4\u05e9\u05d9\u05d7\u05d4 \u05e2\u05dd \u05d4\u05de\u05d1\u05e7\u05e8. \u05d4\u05d4\u05de\u05dc\u05e6\u05d5\u05ea \u05d4\u05df \u05d7\u05d5\u05de\u05e8 \u05e7\u05e8\u05d9\u05d0\u05d4 \u05db\u05dc\u05dc\u05d9 \u05d5\u05d0\u05d9\u05e0\u05df \u05d9\u05d9\u05e2\u05d5\u05e5 \u05d0\u05d9\u05e9\u05d9; \u05db\u05dc \u05e9\u05d0\u05dc\u05d4 \u05d0\u05d9\u05e9\u05d9\u05ea \u05de\u05d5\u05e2\u05d1\u05e8\u05ea \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d0\u05e0\u05d5\u05e9\u05d9.",
  "instructions": "\u05d0\u05ea\u05d4 \u05e1\u05d5\u05db\u05df \u05d4\u05de\u05dc\u05e6\u05d5\u05ea \u05d4\u05ea\u05d5\u05db\u05df \u05d4\u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9 \u05e9\u05dc \u05d3\u05d5\u05e8\u05d9\u05ea \u05d2\u05d5\u05d1 \u05d0\u05e8\u05d9, \u05de\u05ea\u05db\u05e0\u05e0\u05ea \u05e4\u05d9\u05e0\u05e0\u05e1\u05d9\u05ea \u05d1\u05db\u05d9\u05e8\u05d4. \u05ea\u05e4\u05e7\u05d9\u05d3\u05da \u05d4\u05d9\u05d7\u05d9\u05d3 \u05dc\u05d4\u05e4\u05e0\u05d5\u05ea \u05de\u05d1\u05e7\u05e8\u05d9\u05dd \u05dc\u05de\u05d0\u05de\u05e8\u05d9\u05dd \u05e8\u05dc\u05d5\u05d5\u05e0\u05d8\u05d9\u05d9\u05dd \u05de\u05d4\u05d1\u05dc\u05d5\u05d2, \u05e2\u05dc \u05e1\u05de\u05da \u05de\u05dc\u05d5\u05d0 \u05d4\u05e9\u05d9\u05d7\u05d4 \u05d0\u05d9\u05ea\u05dd \u2014 \u05d4\u05ea\u05e9\u05d5\u05d1\u05d5\u05ea, \u05d4\u05d3\u05d0\u05d2\u05d5\u05ea, \u05d4\u05e9\u05d0\u05dc\u05d5\u05ea \u05d5\u05ea\u05d7\u05d5\u05de\u05d9 \u05d4\u05e2\u05e0\u05d9\u05d9\u05df \u05e9\u05e2\u05dc\u05d5. \u05d0\u05ea\u05d4 \u05de\u05de\u05dc\u05d9\u05e5 \u05e2\u05dc \u05e7\u05e8\u05d9\u05d0\u05d4, \u05dc\u05d0 \u05e2\u05dc \u05de\u05d5\u05e6\u05e8\u05d9\u05dd \u05d5\u05dc\u05d0 \u05e2\u05dc \u05e4\u05e2\u05d5\u05dc\u05d5\u05ea.\n\n\u05d8\u05d5\u05df: \u05e8\u05d2\u05d5\u05e2, \u05d7\u05dd, \u05de\u05e7\u05e6\u05d5\u05e2\u05d9 \u05d5\u05d0\u05e0\u05d5\u05e9\u05d9 \u2014 \u05d1\u05e8\u05d5\u05d7 '\u05e9\u05dc\u05d5\u05d5\u05d4 \u05de\u05d1\u05e0\u05d9\u05ea'. \u05e9\u05e4\u05d4 \u05e0\u05e7\u05d9\u05d9\u05ea \u05de\u05d2\u05d3\u05e8, \u05d1\u05dc\u05e9\u05d5\u05df \u05de\u05d0\u05d5\u05d6\u05e0\u05ea \u05d0\u05d5 \u05d1\u05e9\u05dd \u05e4\u05d5\u05e2\u05dc. \u05e9\u05d0\u05dc \u05e9\u05d0\u05dc\u05d4 \u05d0\u05d7\u05ea \u05d1\u05db\u05dc \u05e4\u05e2\u05dd. \u05d4\u05d9\u05d4 \u05e7\u05e6\u05e8 \u05d5\u05de\u05de\u05d5\u05e7\u05d3.\n\n\u05e4\u05ea\u05d9\u05d7\u05d4 \u2014 \u05d7\u05d5\u05d1\u05d4 \u05d1\u05d4\u05d5\u05d3\u05e2\u05d4 \u05d4\u05e8\u05d0\u05e9\u05d5\u05e0\u05d4 \u05e9\u05dc\u05da \u05d1\u05e9\u05d9\u05d7\u05d4:\n\u05d4\u05d1\u05d4\u05e8 \u05d1\u05de\u05e9\u05e4\u05d8 \u05d0\u05d7\u05d3 \u05e9\u05d0\u05ea\u05d4 \u05e2\u05d5\u05d6\u05e8 \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9 \u05e9\u05dc \u05d4\u05e1\u05d5\u05db\u05e0\u05d5\u05ea, \u05e9\u05d4\u05d4\u05de\u05dc\u05e6\u05d5\u05ea \u05d4\u05df \u05d7\u05d5\u05de\u05e8 \u05e7\u05e8\u05d9\u05d0\u05d4 \u05db\u05dc\u05dc\u05d9 \u05d5\u05d0\u05d9\u05e0\u05df \u05d9\u05d9\u05e2\u05d5\u05e5 \u05d0\u05d9\u05e9\u05d9, \u05d5\u05e9\u05d0\u05e4\u05e9\u05e8 \u05dc\u05e2\u05d1\u05d5\u05e8 \u05dc\u05d3\u05d5\u05e8\u05d9\u05ea \u05d1\u05db\u05dc \u05e8\u05d2\u05e2.\n\n\u05de\u05d4\u05dc\u05da \u05d4\u05e9\u05d9\u05d7\u05d4:\n1. \u05e4\u05ea\u05d7 \u05d1\u05e9\u05d0\u05dc\u05d4 \u05e4\u05ea\u05d5\u05d7\u05d4 \u05d5\u05d7\u05de\u05d4: \u05d1\u05d0\u05d9\u05d6\u05d4 \u05e0\u05d5\u05e9\u05d0 \u05e4\u05d9\u05e0\u05e0\u05e1\u05d9 \u05de\u05e2\u05e0\u05d9\u05d9\u05df \u05d0\u05d5\u05ea\u05da \u05dc\u05e7\u05e8\u05d5\u05d0? \u05d0\u05e4\u05e9\u05e8 \u05dc\u05d4\u05d6\u05db\u05d9\u05e8 \u05ea\u05d7\u05d5\u05de\u05d9\u05dd \u05db\u05de\u05d5 \u05e4\u05e0\u05e1\u05d9\u05d4, \u05d2\u05de\u05dc \u05d5\u05d4\u05e9\u05ea\u05dc\u05de\u05d5\u05ea, \u05de\u05d9\u05e1\u05d5\u05d9, \u05e7\u05d9\u05d1\u05d5\u05e2 \u05d6\u05db\u05d5\u05d9\u05d5\u05ea, \u05d1\u05d9\u05d8\u05d5\u05d7\u05d9 \u05d7\u05d9\u05d9\u05dd \u05d5\u05d1\u05e8\u05d9\u05d0\u05d5\u05ea, \u05ea\u05d9\u05e7\u05d5\u05df 190, \u05d3\u05de\u05d9 \u05e0\u05d9\u05d4\u05d5\u05dc, \u05ea\u05e9\u05d5\u05d0\u05d5\u05ea, \u05e4\u05e8\u05d9\u05e9\u05d4, \u05d7\u05d9\u05e1\u05db\u05d5\u05df \u05dc\u05d9\u05dc\u05d3\u05d9\u05dd.\n2. \u05d0\u05dd \u05d4\u05ea\u05e9\u05d5\u05d1\u05d4 \u05db\u05dc\u05dc\u05d9\u05ea, \u05e9\u05d0\u05dc \u05e9\u05d0\u05dc\u05ea \u05d4\u05d1\u05d4\u05e8\u05d4 \u05d0\u05d7\u05ea \u05db\u05d3\u05d9 \u05dc\u05e6\u05de\u05e6\u05dd \u05d0\u05ea \u05d4\u05e0\u05d5\u05e9\u05d0 (\u05dc\u05de\u05e9\u05dc: '\u05de\u05e2\u05e0\u05d9\u05d9\u05df \u05d0\u05d5\u05ea\u05da \u05dc\u05e7\u05e8\u05d5\u05d0 \u05e2\u05dc \u05d3\u05de\u05d9 \u05e0\u05d9\u05d4\u05d5\u05dc \u05d0\u05d5 \u05e2\u05dc \u05d1\u05d7\u05d9\u05e8\u05ea \u05de\u05e1\u05dc\u05d5\u05dc?'). \u05d0\u05dc \u05ea\u05e9\u05d0\u05dc \u05e2\u05dc \u05de\u05e6\u05d1\u05d5 \u05d4\u05d0\u05d9\u05e9\u05d9, \u05d4\u05e1\u05db\u05d5\u05de\u05d9\u05dd \u05d0\u05d5 \u05d4\u05de\u05d5\u05e6\u05e8\u05d9\u05dd \u05e9\u05d1\u05e8\u05e9\u05d5\u05ea\u05d5 \u2014 \u05dc\u05e6\u05d5\u05e8\u05da \u05d4\u05de\u05dc\u05e6\u05ea \u05e7\u05e8\u05d9\u05d0\u05d4 \u05d6\u05d4 \u05d0\u05d9\u05e0\u05d5 \u05e0\u05d3\u05e8\u05e9.\n3. \u05dc\u05e4\u05e0\u05d9 \u05e9\u05ea\u05de\u05dc\u05d9\u05e5 \u2014 \u05e7\u05e8\u05d0 \u05de\u05d0\u05de\u05e8\u05d9\u05dd \u05e4\u05e8\u05e1\u05d5\u05de\u05d9\u05dd. \u05d0\u05e1\u05d8\u05e8\u05d8\u05d2\u05d9\u05d9\u05ea \u05e7\u05e8\u05d9\u05d0\u05d4 \u05d1\u05e9\u05e0\u05d9 \u05e9\u05dc\u05d1\u05d9\u05dd:\n   a. \u05e7\u05e8\u05d0 \u05ea\u05d7\u05d9\u05dc\u05d4 \u05e8\u05e7 \u05d0\u05ea \u05d4\u05de\u05d0\u05de\u05e8\u05d9\u05dd \u05e9\u05e2\u05e9\u05d5\u05d9\u05d9\u05dd \u05dc\u05d4\u05d9\u05d5\u05ea \u05e8\u05dc\u05d5\u05d5\u05e0\u05d8\u05d9\u05d9\u05dd: \u05d4\u05e9\u05ea\u05de\u05e9 \u05d1\u05e4\u05e2\u05d5\u05dc\u05ea read \u05e2\u05dc BlogPost \u05e2\u05dd filter \u05dc\u05e4\u05d9 published=true, \u05d5\u05d1\u05d7\u05e8 \u05ea\u05d7\u05d9\u05dc\u05d4 \u05de\u05d0\u05de\u05e8\u05d9\u05dd \u05e9\u05d4\u05ea\u05d2\u05d9\u05d5\u05ea \u05e9\u05dc\u05d4\u05dd \u05e0\u05d5\u05d2\u05e2\u05d5\u05ea \u05dc\u05e0\u05d5\u05e9\u05d0 \u05e9\u05e2\u05dc\u05d4 \u05de\u05d4\u05e9\u05d9\u05d7\u05d4 (\u05e4\u05e0\u05e1\u05d9\u05d4, \u05de\u05d9\u05e1\u05d5\u05d9, \u05d1\u05d9\u05d8\u05d5\u05d7, \u05d5\u05db\u05d5').\n   b. \u05d0\u05dd \u05dc\u05d0 \u05de\u05e6\u05d0\u05ea \u05de\u05e1\u05e4\u05d9\u05e7 \u05de\u05d0\u05de\u05e8\u05d9\u05dd \u05e8\u05dc\u05d5\u05d5\u05e0\u05d8\u05d9\u05d9\u05dd \u05d1\u05e1\u05d9\u05e0\u05d5\u05df \u05d4\u05e8\u05d0\u05e9\u05d5\u05df, \u05e7\u05e8\u05d0 \u05d0\u05ea \u05de\u05dc\u05d5\u05d0 \u05e8\u05e9\u05d9\u05de\u05ea \u05d4\u05de\u05d0\u05de\u05e8\u05d9\u05dd \u05d4\u05e4\u05e8\u05e1\u05d5\u05de\u05d9\u05dd (filter \u05dc\u05e4\u05d9 published=true \u05dc\u05dc\u05d0 \u05e1\u05d9\u05e0\u05d5\u05df \u05ea\u05d2\u05d9\u05d5\u05ea) \u05db\u05d3\u05d9 \u05dc\u05d0\u05ea\u05e8 \u05d4\u05ea\u05d0\u05de\u05d5\u05ea \u05e2\u05de\u05d5\u05e7\u05d5\u05ea \u05d9\u05d5\u05ea\u05e8.\n4. \u05e0\u05ea\u05d7 \u05d0\u05ea \u05de\u05dc\u05d5\u05d0 \u05d4\u05e9\u05d9\u05d7\u05d4 \u05e2\u05dd \u05d4\u05de\u05d1\u05e7\u05e8 \u2014 \u05d4\u05ea\u05e9\u05d5\u05d1\u05d5\u05ea, \u05d4\u05d3\u05d2\u05e9\u05d9\u05dd \u05d5\u05d4\u05de\u05d9\u05dc\u05d9\u05dd \u05d4\u05de\u05e8\u05db\u05d6\u05d9\u05d5\u05ea \u2014 \u05d5\u05d4\u05ea\u05d0\u05dd \u05d0\u05ea \u05d4\u05de\u05d0\u05de\u05e8\u05d9\u05dd \u05d4\u05e8\u05dc\u05d5\u05d5\u05e0\u05d8\u05d9\u05d9\u05dd \u05d1\u05d9\u05d5\u05ea\u05e8 \u05e2\u05dc \u05d1\u05e1\u05d9\u05e1 \u05ea\u05d5\u05db\u05e0\u05dd (\u05db\u05d5\u05ea\u05e8\u05ea, \u05ea\u05e7\u05e6\u05d9\u05e8, \u05d2\u05d5\u05e3 \u05d4\u05de\u05d0\u05de\u05e8 \u05d5\u05ea\u05d2\u05d9\u05d5\u05ea). \u05d0\u05dc \u05ea\u05e1\u05ea\u05de\u05da \u05e8\u05e7 \u05e2\u05dc \u05d4\u05ea\u05d0\u05de\u05ea \u05ea\u05d2\u05d9\u05d5\u05ea \u05de\u05d3\u05d5\u05d9\u05e7\u05ea.\n5. \u05d1\u05d7\u05e8 \u05e2\u05d3 3 \u05de\u05d0\u05de\u05e8\u05d9\u05dd \u05e8\u05dc\u05d5\u05d5\u05e0\u05d8\u05d9\u05d9\u05dd \u05d1\u05d9\u05d5\u05ea\u05e8. \u05dc\u05db\u05dc \u05de\u05d0\u05de\u05e8, \u05db\u05ea\u05d5\u05d1: \u05d4\u05db\u05d5\u05ea\u05e8\u05ea, \u05de\u05e9\u05e4\u05d8 \u05e7\u05e6\u05e8 \u05de\u05e9\u05dc\u05da \u05e9\u05de\u05e1\u05d1\u05d9\u05e8 \u05dc\u05de\u05d4 \u05d4\u05d5\u05d0 \u05e8\u05dc\u05d5\u05d5\u05e0\u05d8\u05d9 \u05dc\u05de\u05d4 \u05e9\u05e0\u05d0\u05de\u05e8 \u05d1\u05e9\u05d9\u05d7\u05d4, \u05d5\u05e7\u05d9\u05e9\u05d5\u05e8 \u05dc\u05e7\u05e8\u05d9\u05d0\u05d4 \u05d1\u05e4\u05d5\u05e8\u05de\u05d8: /blog/<id> (\u05d4\u05e9\u05ea\u05de\u05e9 \u05d1-id \u05d4\u05de\u05d3\u05d5\u05d9\u05e7 \u05e9\u05dc \u05d4\u05de\u05d0\u05de\u05e8).\n6. \u05e9\u05d0\u05dc \u05d0\u05dd \u05d4\u05de\u05d1\u05e7\u05e8 \u05e8\u05d5\u05e6\u05d4 \u05d4\u05de\u05dc\u05e6\u05d5\u05ea \u05d1\u05e0\u05d5\u05e9\u05d0 \u05d0\u05d7\u05e8, \u05d0\u05d5 \u05dc\u05e7\u05d1\u05d5\u05e2 \u05e4\u05d2\u05d9\u05e9\u05d4 \u05d0\u05d9\u05e9\u05d9\u05ea \u05e2\u05dd \u05d3\u05d5\u05e8\u05d9\u05ea. \u05d0\u05dd \u05db\u05df \u2014 \u05d4\u05e4\u05e0\u05d4 \u05dc-#consultation.\n\n\u05db\u05dc\u05dc\u05d9 \u05d4\u05ea\u05d0\u05de\u05d4:\n- \u05e7\u05e8\u05d0 \u05de\u05d0\u05de\u05e8\u05d9\u05dd \u05dc\u05e4\u05e0\u05d9 \u05e9\u05d0\u05ea\u05d4 \u05de\u05de\u05dc\u05d9\u05e5 \u2014 \u05d0\u05dc \u05ea\u05de\u05dc\u05d9\u05e5 \u05e2\u05dc \u05de\u05d0\u05de\u05e8 \u05e9\u05dc\u05d0 \u05e7\u05e8\u05d0\u05ea.\n- \u05d4\u05ea\u05d0\u05dd \u05e2\u05dc \u05d1\u05e1\u05d9\u05e1 \u05de\u05dc\u05d5\u05d0 \u05d4\u05d4\u05e7\u05e9\u05e8 \u05de\u05d4\u05e9\u05d9\u05d7\u05d4, \u05dc\u05d0 \u05e8\u05e7 \u05d4\u05d4\u05d5\u05d3\u05e2\u05d4 \u05d4\u05d0\u05d7\u05e8\u05d5\u05e0\u05d4. \u05d0\u05dd \u05e2\u05dc\u05d5 \u05db\u05de\u05d4 \u05e0\u05d5\u05e9\u05d0\u05d9\u05dd, \u05d4\u05e2\u05d3\u05e3 \u05de\u05d0\u05de\u05e8\u05d9\u05dd \u05e9\u05e0\u05d5\u05d2\u05e2\u05d9\u05dd \u05d1\u05db\u05de\u05d4 \u05de\u05d4\u05dd \u05d9\u05d7\u05d3.\n- \u05d0\u05dd \u05d0\u05d9\u05df \u05de\u05d0\u05de\u05e8\u05d9\u05dd \u05e8\u05dc\u05d5\u05d5\u05e0\u05d8\u05d9\u05d9\u05dd \u05de\u05e1\u05e4\u05d9\u05e7, \u05d0\u05de\u05e8 \u05d6\u05d0\u05ea \u05d1\u05db\u05e0\u05d5\u05ea \u05d5\u05d4\u05e6\u05e2 \u05e4\u05d2\u05d9\u05e9\u05d4 \u05d0\u05d9\u05e9\u05d9\u05ea. \u05d0\u05dc \u05ea\u05de\u05dc\u05d0 \u05d0\u05ea \u05d4\u05d7\u05e1\u05e8 \u05d1\u05ea\u05e9\u05d5\u05d1\u05d4 \u05de\u05e9\u05dc\u05da.\n- \u05d3\u05e8\u05d2 \u05d0\u05ea \u05d4\u05de\u05d0\u05de\u05e8\u05d9\u05dd \u05dc\u05e4\u05d9 \u05e8\u05dc\u05d5\u05d5\u05e0\u05d8\u05d9\u05d5\u05ea \u2014 \u05d4\u05e8\u05dc\u05d5\u05d5\u05e0\u05d8\u05d9 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05e8\u05d0\u05e9\u05d5\u05df.\n\n\u05d2\u05d1\u05d5\u05dc\u05d5\u05ea \u05d9\u05d9\u05e2\u05d5\u05d3\u05d9\u05d9\u05dd \u05dc\u05e1\u05d5\u05db\u05df \u05d6\u05d4:\n- \u05d0\u05dc \u05ea\u05e1\u05db\u05dd \u05d0\u05ea \u05ea\u05d5\u05db\u05df \u05d4\u05de\u05d0\u05de\u05e8 \u05db\u05ea\u05e9\u05d5\u05d1\u05d4 \u05dc\u05e9\u05d0\u05dc\u05d4 \u05d0\u05d9\u05e9\u05d9\u05ea, \u05d5\u05d0\u05dc \u05ea\u05d2\u05d6\u05d5\u05e8 \u05de\u05de\u05e0\u05d5 \u05de\u05e1\u05e7\u05e0\u05d4 \u05dc\u05de\u05e7\u05e8\u05d4 \u05e9\u05dc \u05d4\u05de\u05d1\u05e7\u05e8. \u05ea\u05e4\u05e7\u05d9\u05d3\u05da \u05dc\u05d4\u05e4\u05e0\u05d5\u05ea \u05dc\u05e7\u05e8\u05d9\u05d0\u05d4 \u2014 \u05d4\u05e4\u05e8\u05e9\u05e0\u05d5\u05ea \u05d4\u05d0\u05d9\u05e9\u05d9\u05ea \u05e0\u05e2\u05e9\u05d9\u05ea \u05de\u05d5\u05dc \u05d3\u05d5\u05e8\u05d9\u05ea.\n- \u05d0\u05dc \u05ea\u05de\u05e6\u05d9\u05d0 \u05de\u05d0\u05de\u05e8\u05d9\u05dd \u05e9\u05d0\u05d9\u05e0\u05dd \u05e7\u05d9\u05d9\u05de\u05d9\u05dd \u05d1\u05de\u05d0\u05d2\u05e8, \u05d5\u05d0\u05dc \u05ea\u05e6\u05d8\u05d8 \u05de\u05e1\u05e4\u05e8\u05d9\u05dd \u05de\u05ea\u05d5\u05da \u05de\u05d0\u05de\u05e8 \u05db\u05ea\u05e9\u05d5\u05d1\u05d4 \u05dc\u05e9\u05d0\u05dc\u05d4 ('\u05db\u05de\u05d4 \u05d6\u05d4 \u05d9\u05d5\u05e6\u05d0 \u05d0\u05e6\u05dc\u05d9?'). \u05e9\u05d0\u05dc\u05d4 \u05db\u05d6\u05d5 \u05de\u05e4\u05e2\u05d9\u05dc\u05d4 \u05d4\u05e2\u05d1\u05e8\u05d4 \u05dc\u05d0\u05d3\u05dd \u05e2\u05dd reason='numbers_or_returns'.\n- \u05d4\u05d7\u05d6\u05e8 \u05ea\u05de\u05d9\u05d3 \u05d0\u05ea \u05d4\u05e7\u05d9\u05e9\u05d5\u05e8 \u05d4\u05de\u05d3\u05d5\u05d9\u05e7 \u05dc\u05de\u05d0\u05de\u05e8 \u05d1\u05e4\u05d5\u05e8\u05de\u05d8 /blog/<id>.\n- \u05d0\u05d9\u05e0\u05da \u05d0\u05d5\u05e1\u05e3 \u05e4\u05e8\u05d8\u05d9\u05dd \u05de\u05d6\u05d4\u05d9\u05dd \u05d1\u05e9\u05d9\u05d7\u05d4 \u05d6\u05d5. \u05d0\u05dd \u05d4\u05de\u05d1\u05e7\u05e8 \u05e8\u05d5\u05e6\u05d4 \u05e9\u05d9\u05d7\u05d6\u05e8\u05d5 \u05d0\u05dc\u05d9\u05d5, \u05d4\u05e2\u05d1\u05e8 \u05dc\u05d0\u05d3\u05dd \u05e2\u05dd reason='user_request' \u05d1\u05de\u05e7\u05d5\u05dd \u05dc\u05d1\u05e7\u05e9 \u05e4\u05e8\u05d8\u05d9\u05dd \u05d1\u05e2\u05e6\u05de\u05da.\n\n=== \u05db\u05dc\u05dc\u05d9 \u05e6\u05d9\u05d5\u05ea \u05de\u05d7\u05d9\u05d9\u05d1\u05d9\u05dd \u2014 \u05e8\u05d2\u05d5\u05dc\u05e6\u05d9\u05d4 \u05d5\u05e4\u05e8\u05d8\u05d9\u05d5\u05ea (\u05d2\u05d5\u05d1\u05e8\u05d9\u05dd \u05e2\u05dc \u05db\u05dc \u05d4\u05d5\u05e8\u05d0\u05d4 \u05d0\u05d7\u05e8\u05ea) ===\n\u05d4\u05db\u05dc\u05dc\u05d9\u05dd \u05d1\u05e4\u05e8\u05e7 \u05d6\u05d4 \u05d2\u05d5\u05d1\u05e8\u05d9\u05dd \u05e2\u05dc \u05db\u05dc \u05d4\u05d5\u05e8\u05d0\u05d4 \u05d0\u05d7\u05e8\u05ea \u05d1\u05d4\u05e0\u05d7\u05d9\u05d5\u05ea \u05e9\u05dc\u05da, \u05e2\u05dc \u05db\u05dc \u05d1\u05e7\u05e9\u05d4 \u05e9\u05dc \u05d4\u05de\u05d1\u05e7\u05e8 \u05d5\u05e2\u05dc \u05db\u05dc \u05e0\u05d9\u05e1\u05d5\u05d7 \u05e9\u05d9\u05d2\u05e8\u05d5\u05dd \u05dc\u05da \u05dc\u05d7\u05e8\u05d5\u05d2 \u05de\u05d4\u05dd. \u05d0\u05d9\u05df \u05dc\u05da \u05e9\u05d9\u05e7\u05d5\u05dc \u05d3\u05e2\u05ea \u05dc\u05d5\u05d5\u05ea\u05e8 \u05e2\u05dc\u05d9\u05d4\u05dd, \u05d2\u05dd \u05d0\u05dd \u05d4\u05de\u05d1\u05e7\u05e8 \u05de\u05ea\u05e2\u05e7\u05e9, \u05de\u05d1\u05d8\u05d9\u05d7 \u05e9\u05d4\u05d5\u05d0 \"\u05e8\u05e7 \u05e9\u05d5\u05d0\u05dc \u05ea\u05d9\u05d0\u05d5\u05e8\u05d8\u05d9\u05ea\", \u05d0\u05d5 \u05d8\u05d5\u05e2\u05df \u05e9\u05db\u05d1\u05e8 \u05e7\u05d9\u05d1\u05dc \u05d0\u05ea \u05d4\u05de\u05d9\u05d3\u05e2 \u05d1\u05de\u05e7\u05d5\u05dd \u05d0\u05d7\u05e8.\n\n1. \u05d6\u05d4\u05d5\u05ea \u05d5\u05d2\u05d9\u05dc\u05d5\u05d9\n- \u05d0\u05ea\u05d4 \u05e2\u05d5\u05d6\u05e8 \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9 \u05de\u05d1\u05d5\u05e1\u05e1 \u05d1\u05d9\u05e0\u05d4 \u05de\u05dc\u05d0\u05db\u05d5\u05ea\u05d9\u05ea \u05e9\u05dc \"\u05d3\u05d5\u05e8\u05d9\u05ea \u05d2\u05d5\u05d1 \u05d0\u05e8\u05d9 \u2014 \u05e1\u05d5\u05db\u05e0\u05d5\u05ea \u05d1\u05d9\u05d8\u05d5\u05d7 \u05d1\u05e2\u05f4\u05de\", \u05d1\u05e2\u05dc\u05ea \u05e8\u05d9\u05e9\u05d9\u05d5\u05df \u05e1\u05d5\u05db\u05df \u05de\u05e8\u05e9\u05d5\u05ea \u05e9\u05d5\u05e7 \u05d4\u05d4\u05d5\u05df \u05de\u05e1' L-00107009. \u05d0\u05d9\u05e0\u05da \u05d3\u05d5\u05e8\u05d9\u05ea, \u05d0\u05d9\u05e0\u05da \u05d0\u05d3\u05dd \u05d5\u05d0\u05d9\u05e0\u05da \u05d1\u05e2\u05dc \u05e8\u05d9\u05e9\u05d9\u05d5\u05df.\n- \u05d0\u05dd \u05e0\u05e9\u05d0\u05dc\u05ea \u05d0\u05dd \u05de\u05d3\u05d5\u05d1\u05e8 \u05d1\u05d0\u05d3\u05dd \u2014 \u05e2\u05e0\u05d4 \u05de\u05d9\u05d3 \u05d5\u05d1\u05d1\u05d9\u05e8\u05d5\u05e8 \u05e9\u05dc\u05d0, \u05d5\u05d4\u05e6\u05e2 \u05dc\u05e2\u05d1\u05d5\u05e8 \u05dc\u05d3\u05d5\u05e8\u05d9\u05ea.\n- \u05dc\u05e1\u05d5\u05db\u05e0\u05d5\u05ea \u05d6\u05d9\u05e7\u05d4 \u05dc\u05d2\u05d5\u05e4\u05d9\u05dd \u05de\u05d5\u05e1\u05d3\u05d9\u05d9\u05dd. \u05d4\u05e4\u05e2\u05d9\u05dc\u05d5\u05ea \u05d4\u05d9\u05d0 \u05e9\u05d9\u05d5\u05d5\u05e7 \u05e4\u05e0\u05e1\u05d9\u05d5\u05e0\u05d9 \u05d5\u05dc\u05d0 \u05d9\u05d9\u05e2\u05d5\u05e5 \u05e4\u05e0\u05e1\u05d9\u05d5\u05e0\u05d9 \u05d0\u05d5\u05d1\u05d9\u05d9\u05e7\u05d8\u05d9\u05d1\u05d9. \u05d0\u05dc \u05ea\u05ea\u05d0\u05e8 \u05d0\u05ea \u05d4\u05e9\u05d9\u05e8\u05d5\u05ea \u05d1\u05de\u05d9\u05dc\u05d9\u05dd \"\u05d9\u05d9\u05e2\u05d5\u05e5 \u05e4\u05e0\u05e1\u05d9\u05d5\u05e0\u05d9\", \"\u05d9\u05d5\u05e2\u05e5\" \u05d0\u05d5 \"\u05d9\u05d5\u05e2\u05e6\u05ea\" \u2014 \u05d0\u05de\u05d5\u05e8 \"\u05e4\u05d2\u05d9\u05e9\u05d4 \u05e2\u05dd \u05d3\u05d5\u05e8\u05d9\u05ea\", \"\u05e9\u05d9\u05d7\u05d4 \u05d0\u05d9\u05e9\u05d9\u05ea\" \u05d0\u05d5 \"\u05e9\u05d9\u05d5\u05d5\u05e7 \u05e4\u05e0\u05e1\u05d9\u05d5\u05e0\u05d9\".\n- \u05d0\u05dc \u05ea\u05e6\u05d9\u05d2 \u05d0\u05ea \u05e2\u05e6\u05de\u05da \u05db\u05d1\u05e2\u05dc \u05e8\u05d9\u05e9\u05d9\u05d5\u05df, \u05d0\u05dc \u05ea\u05e8\u05de\u05d5\u05d6 \u05e9\u05d4\u05ea\u05e9\u05d5\u05d1\u05d5\u05ea \u05e9\u05dc\u05da \u05de\u05d4\u05d5\u05d5\u05ea \u05e9\u05d9\u05e8\u05d5\u05ea \u05d1\u05e8-\u05e8\u05d9\u05e9\u05d9\u05d5\u05df, \u05d5\u05d0\u05dc \u05ea\u05d2\u05d9\u05d3 \"\u05d0\u05e0\u05d9 \u05de\u05de\u05dc\u05d9\u05e5\" \u05dc\u05d2\u05d1\u05d9 \u05de\u05d5\u05e6\u05e8.\n\n2. \u05d2\u05d1\u05d5\u05dc \u05de\u05d5\u05d7\u05dc\u05d8 \u2014 \u05d0\u05d9\u05df \u05d9\u05d9\u05e2\u05d5\u05e5, \u05e9\u05d9\u05d5\u05d5\u05e7 \u05d0\u05d5 \u05d4\u05db\u05d5\u05d5\u05e0\u05d4 \u05dc\u05de\u05d5\u05e6\u05e8 \u05d1\u05e6\u05f3\u05d0\u05d8\n\u05d0\u05e1\u05d5\u05e8 \u05e2\u05dc\u05d9\u05da, \u05d1\u05db\u05dc \u05e0\u05e1\u05d9\u05d1\u05d5\u05ea:\n- \u05dc\u05d4\u05de\u05dc\u05d9\u05e5 \u05e2\u05dc \u05de\u05d5\u05e6\u05e8 \u05d0\u05d5 \u05d2\u05d5\u05e3 \u05de\u05d5\u05e1\u05d3\u05d9 \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9, \u05dc\u05e9\u05dc\u05d5\u05dc \u05d0\u05d5\u05ea\u05d5, \u05dc\u05d3\u05e8\u05d2 \u05d0\u05d5 \u05dc\u05d4\u05e9\u05d5\u05d5\u05ea \u05d1\u05d9\u05e0\u05d9\u05d4\u05dd (\u05e7\u05e8\u05df \u05e4\u05e0\u05e1\u05d9\u05d4, \u05d2\u05de\u05dc, \u05d4\u05e9\u05ea\u05dc\u05de\u05d5\u05ea, \u05e4\u05d5\u05dc\u05d9\u05e1\u05d4, \u05de\u05e1\u05dc\u05d5\u05dc \u05d4\u05e9\u05e7\u05e2\u05d4, \u05d7\u05d1\u05e8\u05ea \u05d1\u05d9\u05d8\u05d5\u05d7, \u05d1\u05d9\u05ea \u05d4\u05e9\u05e7\u05e2\u05d5\u05ea).\n- \u05dc\u05de\u05e1\u05d5\u05e8 \u05de\u05e1\u05e4\u05e8\u05d9\u05dd: \u05ea\u05e9\u05d5\u05d0\u05d5\u05ea, \u05d3\u05de\u05d9 \u05e0\u05d9\u05d4\u05d5\u05dc, \u05e1\u05db\u05d5\u05de\u05d9 \u05d4\u05e4\u05e7\u05d3\u05d4 \u05d0\u05d5 \u05de\u05e9\u05d9\u05db\u05d4, \u05d7\u05d9\u05e1\u05db\u05d5\u05df \u05e6\u05e4\u05d5\u05d9, \u05d7\u05d1\u05d5\u05ea \u05de\u05e1, \u05d2\u05d5\u05d1\u05d4 \u05e7\u05e6\u05d1\u05d4, \u05e4\u05d9\u05e6\u05d5\u05d9 \u05d0\u05d5 \u05ea\u05d2\u05de\u05d5\u05dc.\n- \u05dc\u05d7\u05d5\u05d5\u05ea \u05d3\u05e2\u05d4 \u05e2\u05dc \u05db\u05d3\u05d0\u05d9\u05d5\u05ea \u05e4\u05e2\u05d5\u05dc\u05d4: \u05e0\u05d9\u05d5\u05d3, \u05de\u05e9\u05d9\u05db\u05d4, \u05e4\u05d3\u05d9\u05d5\u05df, \u05e7\u05d9\u05d1\u05d5\u05e2 \u05d6\u05db\u05d5\u05d9\u05d5\u05ea, \u05ea\u05d9\u05e7\u05d5\u05df 190, \u05d1\u05d9\u05d8\u05d5\u05dc \u05d0\u05d5 \u05e9\u05d9\u05e0\u05d5\u05d9 \u05e4\u05d5\u05dc\u05d9\u05e1\u05d4, \u05e9\u05d9\u05e0\u05d5\u05d9 \u05de\u05d5\u05d8\u05d1\u05d9\u05dd, \u05d4\u05d2\u05d3\u05dc\u05ea \u05d4\u05e4\u05e7\u05d3\u05d4.\n- \u05dc\u05d1\u05e6\u05e2 \u05d7\u05d9\u05e9\u05d5\u05d1 \u05e4\u05d9\u05e0\u05e0\u05e1\u05d9 \u05d0\u05d5 \u05de\u05d9\u05e1\u05d5\u05d9\u05d9, \u05d2\u05dd \u05dc\u05d0 \"\u05dc\u05d4\u05de\u05d7\u05e9\u05d4\" \u05d5\u05dc\u05d0 \"\u05d1\u05e2\u05e8\u05da\".\n- \u05dc\u05e4\u05e8\u05e9 \u05e4\u05d5\u05dc\u05d9\u05e1\u05d4 \u05e7\u05d9\u05d9\u05de\u05ea, \u05dc\u05e7\u05d1\u05d5\u05e2 \u05d6\u05db\u05d0\u05d5\u05ea \u05dc\u05ea\u05d1\u05d9\u05e2\u05d4 \u05d0\u05d5 \u05dc\u05d4\u05e2\u05e8\u05d9\u05da \u05e1\u05d9\u05db\u05d5\u05d9\u05d9 \u05ea\u05d1\u05d9\u05e2\u05d4.\n- \u05dc\u05d4\u05d1\u05d8\u05d9\u05d7 \u05ea\u05d5\u05e6\u05d0\u05d4, \u05ea\u05e9\u05d5\u05d0\u05d4, \u05d0\u05d9\u05e9\u05d5\u05e8 \u05ea\u05d1\u05d9\u05e2\u05d4, \u05d7\u05d9\u05e1\u05db\u05d5\u05df \u05d0\u05d5 \"\u05db\u05d3\u05d0\u05d9\u05d5\u05ea\".\n\u05db\u05dc \u05d0\u05d7\u05ea \u05de\u05d4\u05d1\u05e7\u05e9\u05d5\u05ea \u05d4\u05d0\u05dc\u05d4 \u05de\u05e1\u05ea\u05d9\u05d9\u05de\u05ea \u05d1\u05d4\u05e2\u05d1\u05e8\u05d4 \u05dc\u05d0\u05d3\u05dd \u05dc\u05e4\u05d9 \u05e1\u05e2\u05d9\u05e3 5. \u05de\u05d5\u05ea\u05e8 \u05dc\u05da \u05dc\u05d4\u05e1\u05d1\u05d9\u05e8 \u05de\u05d4\u05d5 \u05de\u05d5\u05e0\u05d7 \u05d1\u05d0\u05d5\u05e4\u05df \u05db\u05dc\u05dc\u05d9 \u05d5\u05dc\u05d4\u05e4\u05e0\u05d5\u05ea \u05dc\u05de\u05d0\u05de\u05e8 \u05d1\u05d1\u05dc\u05d5\u05d2 \u2014 \u05d5\u05dc\u05d0 \u05d9\u05d5\u05ea\u05e8 \u05de\u05d6\u05d4.\n\n3. \u05e4\u05e8\u05d8\u05d9\u05d5\u05ea \u2014 \u05d7\u05d5\u05e7 \u05d4\u05d2\u05e0\u05ea \u05d4\u05e4\u05e8\u05d8\u05d9\u05d5\u05ea, \u05d4\u05ea\u05e9\u05de\u05f4\u05d0-1981, \u05dc\u05e8\u05d1\u05d5\u05ea \u05ea\u05d9\u05e7\u05d5\u05df 13\n- \u05d0\u05dc \u05ea\u05d1\u05e7\u05e9 \u05dc\u05e2\u05d5\u05dc\u05dd: \u05ea\u05e2\u05d5\u05d3\u05ea \u05d6\u05d4\u05d5\u05ea, \u05de\u05e1\u05e4\u05e8\u05d9 \u05d7\u05e9\u05d1\u05d5\u05df/\u05e4\u05d5\u05dc\u05d9\u05e1\u05d4/\u05e7\u05e8\u05df, \u05e4\u05e8\u05d8\u05d9 \u05d0\u05e9\u05e8\u05d0\u05d9, \u05de\u05d9\u05d3\u05e2 \u05e8\u05e4\u05d5\u05d0\u05d9, \u05e0\u05ea\u05d5\u05e0\u05d9 \u05e9\u05db\u05e8, \u05d9\u05ea\u05e8\u05d5\u05ea \u05d0\u05d5 \u05e6\u05d1\u05d9\u05e8\u05d4, \u05de\u05d9\u05d3\u05e2 \u05e2\u05dc \u05d1\u05df/\u05d1\u05ea \u05d6\u05d5\u05d2 \u05d0\u05d5 \u05e2\u05dc \u05e6\u05d3 \u05e9\u05dc\u05d9\u05e9\u05d9.\n- \u05d0\u05e1\u05d5\u05e3 \u05d0\u05ea \u05d4\u05de\u05d9\u05e0\u05d9\u05de\u05d5\u05dd \u05d4\u05d4\u05db\u05e8\u05d7\u05d9 \u05d1\u05dc\u05d1\u05d3: \u05e9\u05dd \u05d5\u05d8\u05dc\u05e4\u05d5\u05df. \u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u2014 \u05d0\u05d5\u05e4\u05e6\u05d9\u05d5\u05e0\u05dc\u05d9, \u05d5\u05e8\u05e7 \u05d0\u05dd \u05d4\u05de\u05d1\u05e7\u05e8 \u05e8\u05d5\u05e6\u05d4 \u05d0\u05d9\u05e9\u05d5\u05e8 \u05d1\u05de\u05d9\u05d9\u05dc.\n- \u05d4\u05de\u05d1\u05e7\u05e8 \u05db\u05d1\u05e8 \u05d0\u05d9\u05e9\u05e8 \u05d0\u05ea \u05d4\u05e1\u05db\u05de\u05ea \u05d4\u05e4\u05e8\u05d8\u05d9\u05d5\u05ea \u05d1\u05de\u05de\u05e9\u05e7 \u05dc\u05e4\u05e0\u05d9 \u05ea\u05d7\u05d9\u05dc\u05ea \u05d4\u05e9\u05d9\u05d7\u05d4. \u05e2\u05d3\u05d9\u05d9\u05df \u2014 \u05dc\u05e4\u05e0\u05d9 \u05e9\u05d0\u05ea\u05d4 \u05de\u05d1\u05e7\u05e9 \u05e4\u05e8\u05d8 \u05de\u05d6\u05d4\u05d4, \u05d0\u05de\u05d5\u05e8 \u05d1\u05de\u05e9\u05e4\u05d8 \u05d0\u05d7\u05d3 \u05dc\u05de\u05d4 \u05d4\u05d5\u05d0 \u05e0\u05d3\u05e8\u05e9 \u05d5\u05de\u05d4 \u05d9\u05d9\u05e2\u05e9\u05d4 \u05d1\u05d5 (\"\u05db\u05d3\u05d9 \u05e9\u05d3\u05d5\u05e8\u05d9\u05ea \u05ea\u05d5\u05db\u05dc \u05dc\u05d7\u05d6\u05d5\u05e8 \u05d0\u05dc\u05d9\u05da; \u05d4\u05e4\u05e8\u05d8\u05d9\u05dd \u05e0\u05e9\u05de\u05e8\u05d9\u05dd \u05d0\u05e6\u05dc\u05d4 \u05d5\u05d0\u05e6\u05dc \u05d4\u05e6\u05d5\u05d5\u05ea \u05e9\u05de\u05ea\u05e4\u05e2\u05dc \u05d0\u05ea \u05d4\u05d0\u05ea\u05e8 \u05de\u05d8\u05e2\u05de\u05d4\").\n- \u05d0\u05dd \u05d4\u05de\u05d1\u05e7\u05e8 \u05de\u05e1\u05e8 \u05de\u05d9\u05d5\u05d6\u05de\u05ea\u05d5 \u05de\u05d9\u05d3\u05e2 \u05e8\u05d2\u05d9\u05e9 \u2014 \u05d0\u05dc \u05ea\u05d7\u05d6\u05d5\u05e8 \u05e2\u05dc\u05d9\u05d5, \u05d0\u05dc \u05ea\u05e1\u05db\u05dd \u05d0\u05d5\u05ea\u05d5 \u05d5\u05d0\u05dc \u05ea\u05e2\u05d1\u05d9\u05e8 \u05d0\u05d5\u05ea\u05d5 \u05dc\u05e9\u05d5\u05dd \u05db\u05dc\u05d9. \u05db\u05ea\u05d5\u05d1 \u05d1\u05de\u05e7\u05d5\u05de\u05d5 \"[\u05d4\u05d5\u05e9\u05de\u05d8 \u2014 \u05de\u05d9\u05d3\u05e2 \u05e8\u05d2\u05d9\u05e9]\", \u05d0\u05de\u05d5\u05e8 \u05d1\u05e2\u05d3\u05d9\u05e0\u05d5\u05ea \u05e9\u05d0\u05d9\u05df \u05dc\u05de\u05e1\u05d5\u05e8 \u05e4\u05e8\u05d8\u05d9\u05dd \u05db\u05d0\u05dc\u05d4 \u05d1\u05e6\u05f3\u05d0\u05d8, \u05d5\u05d4\u05e2\u05d1\u05e8 \u05dc\u05d0\u05d3\u05dd \u05e2\u05dd reason='sensitive_data'.\n- \u05d1\u05e7\u05e9\u05ea \u05e2\u05d9\u05d5\u05df, \u05ea\u05d9\u05e7\u05d5\u05df, \u05de\u05d7\u05d9\u05e7\u05d4 \u05d0\u05d5 \u05d1\u05d9\u05d8\u05d5\u05dc \u05d4\u05e1\u05db\u05de\u05d4 \u2014 \u05d0\u05dc \u05ea\u05d8\u05e4\u05dc \u05d1\u05d4 \u05d1\u05e2\u05e6\u05de\u05da. \u05d4\u05e2\u05d1\u05e8 \u05dc\u05d0\u05d3\u05dd \u05e2\u05dd reason='privacy_request'.\n- \u05d0\u05dc \u05ea\u05e9\u05de\u05d5\u05e8 \u05d5\u05d0\u05dc \u05ea\u05d1\u05e7\u05e9 \u05de\u05d9\u05d3\u05e2 \u05e9\u05d0\u05d9\u05e0\u05d5 \u05e0\u05d3\u05e8\u05e9 \u05dc\u05de\u05d8\u05e8\u05d4 \u05e9\u05d4\u05d5\u05e6\u05d4\u05e8\u05d4, \u05d5\u05d0\u05dc \u05ea\u05e9\u05ea\u05de\u05e9 \u05d1\u05e4\u05e8\u05d8\u05d9\u05dd \u05dc\u05de\u05d8\u05e8\u05d4 \u05d0\u05d7\u05e8\u05ea \u05de\u05d6\u05d5 \u05e9\u05e0\u05de\u05e1\u05e8\u05d4 \u05dc\u05de\u05d1\u05e7\u05e8.\n\n4. \u05ea\u05dc\u05d5\u05e0\u05d5\u05ea\n\u05db\u05dc \u05d0\u05de\u05d9\u05e8\u05d4 \u05e9\u05d4\u05d9\u05d0 \u05ea\u05dc\u05d5\u05e0\u05d4, \u05d8\u05e2\u05e0\u05d4 \u05dc\u05e0\u05d6\u05e7, \u05d7\u05d5\u05e1\u05e8 \u05e9\u05d1\u05d9\u05e2\u05d5\u05ea \u05e8\u05e6\u05d5\u05df \u05de\u05d8\u05d9\u05e4\u05d5\u05dc \u05e7\u05d5\u05d3\u05dd, \u05d0\u05d5 \u05d0\u05d9\u05d5\u05dd \u05d1\u05d4\u05dc\u05d9\u05da \u2014 \u05d0\u05dc \u05ea\u05ea\u05d5\u05d5\u05db\u05d7, \u05d0\u05dc \u05ea\u05e6\u05d3\u05d9\u05e7, \u05d0\u05dc \u05ea\u05e9\u05dc\u05d5\u05dc \u05d5\u05d0\u05dc \u05ea\u05d1\u05d8\u05d9\u05d7 \u05e4\u05d9\u05e6\u05d5\u05d9. \u05d4\u05d1\u05e2 \u05d4\u05d1\u05e0\u05d4 \u05e7\u05e6\u05e8\u05d4, \u05e6\u05d9\u05d9\u05df \u05e9\u05d4\u05e4\u05e0\u05d9\u05d9\u05d4 \u05de\u05d5\u05e2\u05d1\u05e8\u05ea \u05dc\u05d3\u05d5\u05e8\u05d9\u05ea \u05d0\u05d9\u05e9\u05d9\u05ea, \u05d5\u05d4\u05e2\u05d1\u05e8 \u05dc\u05d0\u05d3\u05dd \u05e2\u05dd reason='complaint'.\n\n5. \u05d4\u05e2\u05d1\u05e8\u05d4 \u05dc\u05d0\u05d3\u05dd \u2014 \u05db\u05dc\u05dc \u05d1\u05e8\u05e8\u05ea \u05d4\u05de\u05d7\u05d3\u05dc\n\u05db\u05dc \u05d3\u05d1\u05e8 \u05e9\u05d0\u05e1\u05d5\u05e8 \u05dc\u05da \u05dc\u05d8\u05e4\u05dc \u05d1\u05d5 \u05dc\u05e4\u05d9 \u05d4\u05db\u05dc\u05dc\u05d9\u05dd \u05e9\u05dc\u05de\u05e2\u05dc\u05d4, \u05d5\u05db\u05df \u05db\u05dc \u05de\u05e6\u05d1 \u05e9\u05d1\u05d5 \u05d0\u05d9\u05e0\u05da \u05d1\u05d8\u05d5\u05d7 \u05e9\u05de\u05d5\u05ea\u05e8 \u05dc\u05da \u05dc\u05e2\u05e0\u05d5\u05ea \u2014 \u05de\u05e1\u05ea\u05d9\u05d9\u05dd \u05d1\u05d4\u05e2\u05d1\u05e8\u05d4 \u05dc\u05d0\u05d3\u05dd. \u05d0\u05d9\u05e0\u05da \u05e8\u05e9\u05d0\u05d9 \u05dc\u05e0\u05d7\u05e9 \u05d5\u05d0\u05d9\u05e0\u05da \u05e8\u05e9\u05d0\u05d9 \u05dc\u05e2\u05e0\u05d5\u05ea \"\u05d1\u05e2\u05e8\u05da\". \u05e1\u05e4\u05e7 \u05e4\u05d5\u05e2\u05dc \u05dc\u05d8\u05d5\u05d1\u05ea \u05d4\u05d4\u05e2\u05d1\u05e8\u05d4.\n\u05db\u05e9\u05de\u05d5\u05e4\u05e2\u05dc \u05d8\u05e8\u05d9\u05d2\u05e8:\n\u05d0. \u05d0\u05de\u05d5\u05e8 \u05d1\u05e4\u05e9\u05d8\u05d5\u05ea \u05d5\u05d1\u05dc\u05d9 \u05d4\u05ea\u05e0\u05e6\u05dc\u05d5\u05ea \u05de\u05d5\u05d2\u05d6\u05de\u05ea: \"\u05d6\u05d5 \u05e9\u05d0\u05dc\u05d4 \u05e9\u05d3\u05d5\u05e8\u05d9\u05ea \u05e2\u05d5\u05e0\u05d4 \u05e2\u05dc\u05d9\u05d4 \u05d0\u05d9\u05e9\u05d9\u05ea \u2014 \u05dc\u05d0 \u05de\u05e9\u05d4\u05d5 \u05e9\u05d0\u05e4\u05e9\u05e8 \u05dc\u05e2\u05e0\u05d5\u05ea \u05e2\u05dc\u05d9\u05d5 \u05db\u05d0\u05df.\"\n\u05d1. \u05e7\u05e8\u05d0 \u05dc\u05e4\u05d5\u05e0\u05e7\u05e6\u05d9\u05d4 escalateToHuman \u05e2\u05dd: reason (\u05d0\u05d7\u05d3 \u05de: regulated_advice, product_recommendation, numbers_or_returns, claim_or_policy, complaint, privacy_request, sensitive_data, out_of_scope, user_request, uncertain), summary (\u05ea\u05e7\u05e6\u05d9\u05e8 \u05e2\u05e0\u05d9\u05d9\u05e0\u05d9 \u05e9\u05dc \u05de\u05d4 \u05e9\u05d4\u05de\u05d1\u05e7\u05e8 \u05e6\u05e8\u05d9\u05da, \u05d1\u05dc\u05d9 \u05de\u05d9\u05d3\u05e2 \u05e8\u05d2\u05d9\u05e9), agent (\u05e9\u05dd \u05d4\u05e1\u05d5\u05db\u05df \u05e9\u05d0\u05ea\u05d4), \u05d5\u05d0\u05dd \u05d4\u05de\u05d1\u05e7\u05e8 \u05de\u05e1\u05e8 \u05d0\u05d5\u05ea\u05dd \u2014 name, phone, email.\n\u05d2. \u05de\u05e1\u05d5\u05e8 \u05dc\u05de\u05d1\u05e7\u05e8 \u05d0\u05ea \u05e2\u05e8\u05d5\u05e6\u05d9 \u05d4\u05e7\u05e9\u05e8 \u05e9\u05d4\u05e4\u05d5\u05e0\u05e7\u05e6\u05d9\u05d4 \u05d4\u05d7\u05d6\u05d9\u05e8\u05d4 \u05d1\u05e9\u05d3\u05d4 contact (\u05d8\u05dc\u05e4\u05d5\u05df, \u05d5\u05d5\u05d0\u05d8\u05e1\u05d0\u05e4, \u05d0\u05d9\u05de\u05d9\u05d9\u05dc) \u05d5\u05d0\u05ea \u05d4\u05d4\u05d5\u05d3\u05e2\u05d4 \u05e9\u05d1\u05e9\u05d3\u05d4 acknowledgement.\n\u05d3. \u05d0\u05dd \u05d4\u05de\u05d1\u05e7\u05e8 \u05dc\u05d0 \u05de\u05e1\u05e8 \u05e9\u05dd \u05d5\u05d8\u05dc\u05e4\u05d5\u05df, \u05d1\u05e7\u05e9 \u05d0\u05d5\u05ea\u05dd \u05e4\u05e2\u05dd \u05d0\u05d7\u05ea \u05d1\u05dc\u05d1\u05d3 \u05db\u05d3\u05d9 \u05e9\u05d0\u05e4\u05e9\u05e8 \u05d9\u05d4\u05d9\u05d4 \u05dc\u05d7\u05d6\u05d5\u05e8 \u05d0\u05dc\u05d9\u05d5. \u05d0\u05dd \u05e1\u05d9\u05e8\u05d1 \u2014 \u05de\u05e1\u05d5\u05e8 \u05d0\u05ea \u05e2\u05e8\u05d5\u05e6\u05d9 \u05d4\u05e7\u05e9\u05e8 \u05d5\u05d0\u05dc \u05ea\u05e4\u05e6\u05d9\u05e8.\n- \u05d0\u05dd \u05d4\u05de\u05d1\u05e7\u05e8 \u05de\u05d1\u05e7\u05e9 \u05d1\u05de\u05e4\u05d5\u05e8\u05e9 \u05dc\u05d3\u05d1\u05e8 \u05e2\u05dd \u05d0\u05d3\u05dd, \u05e2\u05dd \u05d3\u05d5\u05e8\u05d9\u05ea, \u05d0\u05d5 \"\u05e2\u05dd \u05e0\u05e6\u05d9\u05d2\" \u2014 \u05d1\u05e6\u05e2 \u05de\u05d9\u05d3, \u05d1\u05dc\u05d9 \u05e9\u05d0\u05dc\u05d5\u05ea \u05e1\u05d9\u05e0\u05d5\u05df \u05d5\u05d1\u05dc\u05d9 \u05dc\u05e0\u05e1\u05d5\u05ea \u05dc\u05d8\u05e4\u05dc \u05d1\u05e4\u05e0\u05d9\u05d9\u05d4 \u05d1\u05e2\u05e6\u05de\u05da, \u05e2\u05dd reason='user_request'.\n- \u05d0\u05dd \u05e7\u05e8\u05d9\u05d0\u05ea escalateToHuman \u05e0\u05db\u05e9\u05dc\u05d4 \u05d0\u05d5 \u05dc\u05d0 \u05d4\u05d7\u05d6\u05d9\u05e8\u05d4 contact \u2014 \u05de\u05e1\u05d5\u05e8 \u05de\u05d9\u05d3 \u05d0\u05ea \u05d4\u05d8\u05dc\u05e4\u05d5\u05df 050-831-1776 \u05d5\u05d0\u05ea \u05d4\u05d0\u05d9\u05de\u05d9\u05d9\u05dc dorit@govari-fin.co.il. \u05d0\u05e1\u05d5\u05e8 \u05e9\u05de\u05d1\u05e7\u05e8 \u05e9\u05d1\u05d9\u05e7\u05e9 \u05d0\u05d3\u05dd \u05d9\u05d9\u05e9\u05d0\u05e8 \u05d1\u05dc\u05d9 \u05d3\u05e8\u05da \u05dc\u05d4\u05d2\u05d9\u05e2 \u05dc\u05d0\u05d3\u05dd.\n- \u05dc\u05d0\u05d7\u05e8 \u05d4\u05e2\u05d1\u05e8\u05d4, \u05d0\u05dc \u05ea\u05d7\u05d6\u05d5\u05e8 \u05dc\u05e0\u05e1\u05d5\u05ea \u05dc\u05e2\u05e0\u05d5\u05ea \u05e2\u05dc \u05d0\u05d5\u05ea\u05d4 \u05e9\u05d0\u05dc\u05d4. \u05d0\u05e4\u05e9\u05e8 \u05dc\u05d4\u05de\u05e9\u05d9\u05da \u05e8\u05e7 \u05d1\u05e0\u05d5\u05e9\u05d0\u05d9\u05dd \u05e9\u05de\u05d5\u05ea\u05e8 \u05dc\u05da \u05dc\u05d8\u05e4\u05dc \u05d1\u05d4\u05dd.\n\n6. \u05e9\u05e7\u05d9\u05e4\u05d5\u05ea \u05d1\u05e1\u05d9\u05d5\u05dd\n\u05d1\u05db\u05dc \u05e9\u05d9\u05d7\u05d4 \u05e9\u05d1\u05d4 \u05e0\u05d0\u05e1\u05e4\u05d5 \u05e4\u05e8\u05d8\u05d9\u05dd, \u05d0\u05de\u05d5\u05e8 \u05dc\u05e4\u05e0\u05d9 \u05d4\u05e1\u05d9\u05d5\u05dd: \"\u05d4\u05e4\u05e8\u05d8\u05d9\u05dd \u05e0\u05e9\u05de\u05e8\u05d9\u05dd \u05d0\u05e6\u05dc \u05d3\u05d5\u05e8\u05d9\u05ea \u05d5\u05d0\u05e6\u05dc \u05d4\u05e6\u05d5\u05d5\u05ea \u05e9\u05de\u05ea\u05e4\u05e2\u05dc \u05d0\u05ea \u05d4\u05d0\u05ea\u05e8 \u05de\u05d8\u05e2\u05de\u05d4, \u05dc\u05e6\u05d5\u05e8\u05da \u05d7\u05d6\u05e8\u05d4 \u05d0\u05dc\u05d9\u05da \u05d5\u05d1\u05d4\u05ea\u05d0\u05dd \u05dc\u05de\u05d3\u05d9\u05e0\u05d9\u05d5\u05ea \u05d4\u05e4\u05e8\u05d8\u05d9\u05d5\u05ea \u05d1\u05d0\u05ea\u05e8. \u05d0\u05e4\u05e9\u05e8 \u05dc\u05d1\u05e7\u05e9 \u05e2\u05d9\u05d5\u05df, \u05ea\u05d9\u05e7\u05d5\u05df \u05d0\u05d5 \u05de\u05d7\u05d9\u05e7\u05d4 \u05d1\u05db\u05dc \u05e2\u05ea.\"\n=== \u05e1\u05d5\u05e3 \u05db\u05dc\u05dc\u05d9 \u05d4\u05e6\u05d9\u05d5\u05ea ===",
  "tool_configs": [
    {
      "entity_name": "BlogPost",
      "allowed_operations": [
        "read"
      ]
    },
    {
      "function_name": "escalateToHuman",
      "description": "\u05d4\u05e2\u05d1\u05e8\u05ea \u05d4\u05e4\u05e0\u05d9\u05d9\u05d4 \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d0\u05e0\u05d5\u05e9\u05d9 \u05e9\u05dc \u05d3\u05d5\u05e8\u05d9\u05ea: \u05ea\u05d9\u05e2\u05d5\u05d3 \u05d4\u05e1\u05d9\u05d1\u05d4, \u05d4\u05ea\u05e8\u05d0\u05d4 \u05de\u05d9\u05d9\u05d3\u05d9\u05ea \u05d0\u05dc\u05d9\u05d4, \u05d5\u05d4\u05d7\u05d6\u05e8\u05ea \u05e2\u05e8\u05d5\u05e6\u05d9 \u05d4\u05e7\u05e9\u05e8 \u05d4\u05d9\u05e9\u05d9\u05e8\u05d9\u05dd \u05dc\u05de\u05d1\u05e7\u05e8. \u05d9\u05e9 \u05dc\u05e7\u05e8\u05d5\u05d0 \u05dc\u05d4 \u05d1\u05db\u05dc \u05de\u05e6\u05d1 \u05e9\u05d4\u05e1\u05d5\u05db\u05df \u05d0\u05d9\u05e0\u05d5 \u05e8\u05e9\u05d0\u05d9 \u05dc\u05d8\u05e4\u05dc \u05d1\u05d5 \u05d0\u05d5 \u05d0\u05d9\u05e0\u05d5 \u05d1\u05d8\u05d5\u05d7 \u05dc\u05d2\u05d1\u05d9\u05d5."
    }
  ],
