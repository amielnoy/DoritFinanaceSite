{
  // יומן האירועים של האתר — כל פנייה וכל העברה לאדם נרשמות כשורה בגיליון.
  //
  // החיבור מאושר פעם אחת, בחשבון **amielnoy@gmail.com**, והגיליון עצמו נמצא
  // באותו חשבון. זהו חיבור ברמת האפליקציה ולא של משתמש קצה: הכתיבה נעשית
  // מהשרת ב-asServiceRole, ולמבקרים באתר אין ולא נדרשת גישה לגיליון.
  //
  // ההרשאה היא spreadsheets ולא drive: די בה כדי לכתוב לגיליון קיים שמזהה שלו
  // ידוע, ואין בה גישה לשאר הקבצים בחשבון.
  "type": "googlesheets",
  "scopes": [
    "https://www.googleapis.com/auth/spreadsheets",
    "email"
  ]
}
