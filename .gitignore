#env
.env
.env.*

# Logs
/logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
# Output of CI's "build the way the Builder does" guard. Never the artifact —
# see the step in .github/workflows/ci.yml for what happened when it was.
dist-builder-check
*.local

# Nitro build output, once this app has a server. Both are regenerated by
# every build, and the deploy runs one before reading them.
.output
.wrangler

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

.env
.vite
base44/.app.jsonc

# Test output
/test-results
/playwright-report
/playwright/.cache

# Allure: raw results from a run, the report generated from them, and the
# trend history the report is built against (CI keeps that one in a cache).
/allure-results
/allure-report
/allure-report-site
/allure-history
.vercel
.env*

# Operational logs pulled from Base44 by scripts/archive-logs.mjs.
# Kept as CI artifacts, never committed — see the `logs` job in ci.yml.
logs/
