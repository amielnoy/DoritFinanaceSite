{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "cleanUrls": true,
  "buildCommand": "npx playwright install chromium && npm run build:prerender",
  "outputDirectory": "dist",
  "installCommand": "npm i -g npm@12 && npm ci",
  "git": {
    "deploymentEnabled": {
      "main": false,
      "builder": false
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://safe-arch-plan.base44.app/api/:path*"
    },
    {
      "source": "/ws-user-apps/:path*",
      "destination": "https://safe-arch-plan.base44.app/ws-user-apps/:path*"
    },
    {
      "source": "/blog/:id([0-9a-f]{24})",
      "destination": "/api/og/blog?id=:id"
    },
    {
      "source": "/blog/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(GPTBot|ChatGPT-User|OAI-SearchBot|ClaudeBot|Claude-User|Claude-SearchBot|PerplexityBot|Perplexity-User|Google-Extended|Applebot-Extended|CCBot|Googlebot|Bingbot|facebookexternalhit|Twitterbot|LinkedInBot|Slackbot|WhatsApp|TelegramBot|Discordbot).*"
        }
      ],
      "destination": "/api/og/blog?id=:id"
    },
    {
      "source": "/:page(privacy|accessibility|blog|claims|faq|tools|pension-check|atzmaim-31-12|perspective|masleka|login|account)",
      "destination": "/app"
    },
    {
      "source": "/blog/:key",
      "destination": "/app"
    },
    {
      "source": "/admin/:page(leads|users|blog|masleka)",
      "destination": "/app"
    },
    {
      "source": "/admin/masleka/guide",
      "destination": "/app"
    },
    {
      "source": "/admin/masleka/analysis/:snapshotId",
      "destination": "/app"
    },
    {
      "source": "/:locale(en|fr)",
      "destination": "/app"
    },
    {
      "source": "/:locale(en|fr)/:page(tools|pension-check|claims|faq|atzmaim-31-12)",
      "destination": "/app"
    }
  ],
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/((?!assets/|fonts/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/:page(login|account|masleka|app|404)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/admin/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://www.googletagmanager.com 'sha256-rkx8REg+QNSzaGknwZcO9drpaf+3v1f74Qr6jPG/6FM=' 'sha256-e+vlOT20Qwy4PgGocJvj5eilZioNzvfLgxaBuNzKdl0='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://hjowdyiwjjrqceumkvgt.supabase.co/storage/v1/object/public/content-images/ https://media.base44.com https://base44.com https://base44.app https://safe-arch-plan.base44.app https://static.wixstatic.com https://www.googletagmanager.com https://*.google-analytics.com; font-src 'self'; connect-src 'self' https://safe-arch-plan.base44.app wss://safe-arch-plan.base44.app https://hjowdyiwjjrqceumkvgt.supabase.co https://www.googletagmanager.com https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; report-uri /api/csp-report; report-to csp"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "require-trusted-types-for 'script'; report-uri /api/csp-report; report-to csp"
        },
        {
          "key": "Reporting-Endpoints",
          "value": "csp=\"/api/csp-report\""
        }
      ]
    }
  ]
}
