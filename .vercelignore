# NOTE: once this file exists it REPLACES .gitignore for upload filtering, so
# everything .gitignore excludes has to be repeated here. Without it the CLI
# uploaded the whole 566 MB working directory; with an incomplete version it
# still sent 40 MB of Allure screenshots and videos.
#
# Vercel installs dependencies and builds on its own runners, so the upload
# only needs source.

node_modules
dist
.output
.wrangler
.vite

# Test artefacts — regenerated by every run
test-results
playwright-report
playwright/.cache
allure-results
allure-report

# History is not needed for a CLI deploy
.git

# Local-only
.env
.env.*
base44/.app.jsonc
*.log
.DS_Store
