# Cloudflare Pages → Settings → Environment variables.
# Copy to .dev.vars for `wrangler pages dev` (it is gitignored).

RESEND_API_KEY=re_xxxxxxxxxxxx

# Must be on the domain verified in Resend — the subdomain, not the apex.
# govari-fin.co.il points at Microsoft 365 with an SPF ending in -all, so
# sending as the apex fails hard.
MAIL_FROM=דורית גוב ארי <notifications@mail.govari-fin.co.il>

# Comma-separated. The first is the agency's and is used as Reply-To.
MAIL_TO=dorit@govari-fin.co.il,amielnoy@gmail.com,amielnoy@outlook.com

# Shared secret the Supabase Edge Functions send as `Authorization: Bearer <token>`
# (their own secret is named MAILER_TOKEN). Without a token this endpoint is an
# open relay. Generate: openssl rand -hex 32
MAILER_TOKEN_SUPABASE=

# CORS only — no browser calls this endpoint.
ALLOWED_ORIGIN=https://govari-fin.co.il
