{
  "name": "base44-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:prerender": "vite build && node scripts/prerender.mjs",
    "prerender": "node scripts/prerender.mjs",
    "lint": "eslint . --quiet",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p ./tsconfig.json",
    "typecheck:gate": "npm run typecheck",
    "preview": "vite preview",
    "seed:blog": "node scripts/seed-blog.mjs",
    "logs": "base44 logs --env prod --since 1h",
    "logs:archive": "node scripts/archive-logs.mjs",
    "test": "npm run test:vitest && npm run test:e2e",
    "test:unit": "vitest run tests/unit",
    "test:component": "vitest run tests/component",
    "test:contract": "vitest run tests/contract",
    "test:integration": "vitest run tests/integration",
    "test:eval": "vitest run tests/eval",
    "test:security": "vitest run tests/security",
    "test:vitest": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:web": "playwright test --project=web-chromium --project=web-webkit",
    "test:e2e:ios": "playwright test --project=ios-safari",
    "test:e2e:android": "playwright test --project=android-chrome",
    "test:e2e:ui": "playwright test e2e/ui",
    "test:e2e:api": "playwright test e2e/api",
    "test:e2e:a11y": "playwright test e2e/a11y",
    "test:e2e:security": "playwright test e2e/security",
    "test:e2e:seo": "playwright test e2e/seo",
    "test:e2e:report": "playwright show-report",
    "allure:generate": "allure generate allure-results -c allurerc.mjs -o allure-report && node scripts/strip-allure-analytics.mjs",
    "allure:open": "npm run allure:generate && allure open allure-report",
    "allure:generate:site": "ALLURE_SINGLE_FILE=0 allure generate allure-results -c allurerc.mjs -o allure-report-site && node scripts/strip-allure-analytics.mjs allure-report-site/index.html",
    "test:all": "./scripts/run-tests.sh",
    "test:docker": "docker compose -f docker-compose.test.yml run --rm tests"
  },
  "dependencies": {
    "@base44/sdk": "^0.8.48",
    "@base44/vite-plugin": "^1.0.41",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-aspect-ratio": "^1.1.2",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-collapsible": "^1.1.3",
    "@radix-ui/react-context-menu": "^2.2.6",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-hover-card": "^1.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-menubar": "^1.1.6",
    "@radix-ui/react-navigation-menu": "^1.2.5",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-radio-group": "^1.2.3",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toast": "^1.2.2",
    "@radix-ui/react-toggle": "^1.1.2",
    "@radix-ui/react-toggle-group": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@tanstack/react-query": "^5.84.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "embla-carousel-react": "^8.5.2",
    "framer-motion": "^11.16.4",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.475.0",
    "next-themes": "^0.4.4",
    "react": "^18.2.0",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.54.2",
    "react-markdown": "^9.0.1",
    "react-resizable-panels": "^2.1.7",
    "react-router-dom": "^6.26.0",
    "recharts": "^2.15.4",
    "sonner": "^2.0.1",
    "tailwind-merge": "^3.0.2",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.19.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^22.13.5",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^6.0.5",
    "allure": "^3.16.0",
    "allure-playwright": "^3.11.1",
    "allure-vitest": "^3.11.1",
    "autoprefixer": "^10.4.20",
    "baseline-browser-mapping": "^2.8.32",
    "eslint": "^9.19.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "eslint-plugin-unused-imports": "^4.3.0",
    "globals": "^15.14.0",
    "jsdom": "^30.0.1",
    "nitro": "^3.0.260610-beta",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.46.0",
    "vite": "^8.2.0",
    "vitest": "^3.2.7",
    "wrangler": "^4.129.0"
  }
}
